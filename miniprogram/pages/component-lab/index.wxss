.component-page {
  padding-bottom: 280rpx;
}

.component-content {
  padding: var(--space-4);
}

.section {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  margin-bottom: var(--space-6);
}

.section__title {
  color: var(--color-on-surface);
  font-size: var(--font-size-headline-md);
  font-weight: 700;
  line-height: var(--line-height-headline-md);
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.slot-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-3);
}

.demo-button {
  min-height: 88rpx;
  margin: 0;
  border-radius: var(--radius-md);
  background: var(--color-primary-container);
  color: var(--color-on-primary);
  font-size: var(--font-size-body-md);
  font-weight: 700;
}

.demo-button::after {
  border: 0;
}

.floating-action {
  position: fixed;
  right: 0;
  bottom: var(--height-bottom-nav);
  left: 0;
  z-index: 20;
}

.nav-preview {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 21;
}
