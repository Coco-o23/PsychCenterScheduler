@import "./tokens.wxss";

.profile-page {
  min-height: 100vh;
  background: #f8f9ff;
}

.profile-page__content {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  padding: 24rpx 24rpx calc(180rpx + env(safe-area-inset-bottom));
}

.profile-page__profile-card,
.profile-page__grid-card,
.profile-page__settings-card {
  position: relative;
  overflow: hidden;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(25, 28, 35, 0.06);
}

.profile-page__profile-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 28rpx 28rpx 0;
}

.profile-page__profile-accent {
  width: 8rpx;
  align-self: stretch;
  border-radius: 0 999rpx 999rpx 0;
  background: var(--color-primary);
}

.profile-page__profile-avatar {
  display: flex;
  width: 96rpx;
  height: 96rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #eaf2ff;
  color: var(--color-primary);
  font-size: 40rpx;
  font-weight: 700;
}

.profile-page__profile-main {
  min-width: 0;
  flex: 1;
}

.profile-page__profile-name {
  display: block;
  margin-bottom: 8rpx;
  color: var(--color-on-surface);
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.3;
}

.profile-page__profile-line {
  display: block;
  color: var(--color-on-surface-variant);
  font-size: 26rpx;
  line-height: 1.55;
  word-break: break-all;
}

.profile-page__section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 0 6rpx;
}

.profile-page__section-title,
.profile-page__section-label {
  color: var(--color-on-surface);
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.35;
}

.profile-page__section-label {
  padding: 6rpx;
  color: var(--color-on-surface-variant);
  font-size: 28rpx;
  font-weight: 500;
}

.profile-page__link-button {
  margin: 0;
  padding: 0;
  background: transparent;
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.4;
}

.profile-page__link-button::after {
  border: 0;
}

.profile-page__grid-card {
  padding: 0;
}

.profile-page__grid-head,
.profile-page__grid-row {
  display: flex;
}

.profile-page__grid-head-cell,
.profile-page__grid-cell {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-right: 2rpx solid #e7ebf4;
  border-bottom: 2rpx solid #e7ebf4;
}

.profile-page__grid-head-cell {
  min-height: 60rpx;
  background: #f3f6ff;
  color: var(--color-on-surface-variant);
  font-size: 22rpx;
  font-weight: 600;
}

.profile-page__grid-cell {
  min-height: 120rpx;
  background: #ffffff;
}

.profile-page__grid-cell--active {
  background: #e9f1ff;
}

.profile-page__grid-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--color-primary);
}

.profile-page__grid-head-cell:last-child,
.profile-page__grid-cell:last-child {
  border-right: 0;
}

.profile-page__grid-row:last-child .profile-page__grid-cell {
  border-bottom: 0;
}

.profile-page__availability-editor {
  overflow: hidden;
  border-radius: 20rpx;
  border: 2rpx solid #dfe6f4;
}

.profile-page__availability-head,
.profile-page__availability-row {
  display: flex;
}

.profile-page__availability-label-cell,
.profile-page__availability-head-cell,
.profile-page__availability-cell {
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-right: 2rpx solid #e6ebf5;
  border-bottom: 2rpx solid #e6ebf5;
}

.profile-page__availability-label-cell {
  width: 120rpx;
  flex: 0 0 120rpx;
  color: var(--color-on-surface-variant);
  font-size: 24rpx;
  font-weight: 600;
}

.profile-page__availability-head-cell,
.profile-page__availability-cell {
  flex: 1;
}

.profile-page__availability-head-cell {
  min-height: 56rpx;
  background: #f3f6ff;
  color: var(--color-on-surface-variant);
  font-size: 22rpx;
  font-weight: 600;
}

.profile-page__availability-cell {
  min-height: 110rpx;
  margin: 0;
  padding: 0;
  background: #ffffff;
}

.profile-page__availability-cell::after {
  border: 0;
}

.profile-page__availability-cell--active {
  background: #95f08d;
}

.profile-page__availability-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--color-primary);
}

.profile-page__availability-head-cell:last-child,
.profile-page__availability-cell:last-child {
  border-right: 0;
}

.profile-page__availability-row:last-child .profile-page__availability-label-cell,
.profile-page__availability-row:last-child .profile-page__availability-cell {
  border-bottom: 0;
}

.profile-page__settings-card {
  padding: 0;
}

.profile-page__setting-row {
  display: flex;
  width: 100%;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin: 0;
  padding: 28rpx;
  border-bottom: 2rpx solid #edf0f6;
  background: #ffffff;
  text-align: left;
}

.profile-page__setting-row:last-child {
  border-bottom: 0;
}

.profile-page__setting-row::after {
  border: 0;
}

.profile-page__setting-main {
  min-width: 0;
  flex: 1;
}

.profile-page__setting-title {
  display: block;
  color: var(--color-on-surface);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.5;
}

.profile-page__setting-summary {
  display: block;
  margin-top: 8rpx;
  color: var(--color-on-surface-variant);
  font-size: 26rpx;
  line-height: 1.45;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-page__setting-arrow {
  color: var(--color-on-surface-variant);
  font-size: 40rpx;
  line-height: 1;
}

.profile-page__inline-note {
  padding: 0 6rpx;
  color: var(--color-on-surface-variant);
  font-size: 22rpx;
  line-height: 1.6;
}

.profile-page__modal-mask {
  position: fixed;
  inset: 0;
  z-index: 40;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  background: rgba(19, 27, 43, 0.28);
}

.profile-page__modal {
  width: 100%;
  max-height: 78vh;
  overflow: hidden;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: var(--shadow-modal);
}

.profile-page__modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 20rpx;
}

.profile-page__modal-title {
  color: var(--color-on-surface);
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.35;
}

.profile-page__modal-close {
  width: 64rpx;
  height: 64rpx;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: transparent;
  color: var(--color-on-surface-variant);
  font-size: 40rpx;
  line-height: 64rpx;
}

.profile-page__modal-close::after {
  border: 0;
}

.profile-page__modal-body {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding: 0 32rpx 28rpx;
}

.profile-page__modal-scroll {
  max-height: 54vh;
}

.profile-page__modal-copy {
  color: var(--color-on-surface-variant);
  font-size: 26rpx;
  line-height: 1.6;
}

.profile-page__field-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.profile-page__field {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.profile-page__field-label {
  color: var(--color-on-surface-variant);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.4;
}

.profile-page__input {
  width: 100%;
  min-height: 84rpx;
  box-sizing: border-box;
}

.profile-page__weekday-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.profile-page__weekday-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 132rpx;
  min-height: 72rpx;
  margin: 0;
  padding: 0 24rpx;
  border: 2rpx solid #c7d2e8;
  border-radius: 999rpx;
  background: #ffffff;
  color: var(--color-on-surface);
  font-size: 26rpx;
  line-height: 1.3;
}

.profile-page__weekday-chip::after {
  border: 0;
}

.profile-page__weekday-chip--active {
  border-color: var(--color-primary);
  background: #95f08d;
  color: #075f1f;
}

.profile-page__editor-card {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #f7f9ff;
}

.profile-page__editor-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.profile-page__editor-title {
  color: var(--color-on-surface);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.4;
}

.profile-page__editor-link {
  margin: 0;
  padding: 0;
  background: transparent;
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 600;
}

.profile-page__editor-link::after {
  border: 0;
}

.profile-page__editor-link--danger {
  color: #c62828;
}

.profile-page__switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.profile-page__secondary-button {
  width: 100%;
  min-height: 76rpx;
  margin: 0;
  border-radius: 999rpx;
  background: #eff4ff;
  color: var(--color-primary);
  font-size: 26rpx;
  font-weight: 700;
}

.profile-page__secondary-button::after {
  border: 0;
}

.profile-page__modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  padding: 18rpx 32rpx 28rpx;
}

.profile-page__modal-button {
  min-width: 136rpx;
  min-height: 76rpx;
  margin: 0;
  padding: 0 30rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.profile-page__modal-button::after {
  border: 0;
}

.profile-page__modal-button--ghost {
  background: transparent;
  color: var(--color-primary);
}

.profile-page__modal-button--primary {
  background: var(--color-primary);
  color: var(--color-on-primary);
}

.profile-page__guard {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 32rpx;
}
