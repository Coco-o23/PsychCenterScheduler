page,
:host {
  --color-surface: #f9f9ff;
  --color-surface-dim: #d8d9e3;
  --color-surface-container-lowest: #ffffff;
  --color-surface-container-low: #f2f3fd;
  --color-surface-container: #ecedf7;
  --color-surface-container-high: #e6e8f2;
  --color-on-surface: #191c23;
  --color-on-surface-variant: #414754;
  --color-outline: #727785;
  --color-outline-variant: #c1c6d6;
  --color-primary: #005bbf;
  --color-primary-container: #1a73e8;
  --color-on-primary: #ffffff;
  --color-secondary: #006e2c;
  --color-secondary-container: #86f898;
  --color-on-secondary-container: #003914;
  --color-tertiary: #9e4300;
  --color-tertiary-container: #ffdbcb;
  --color-error: #ba1a1a;
  --color-error-container: #ffdad6;
  --color-on-error-container: #93000a;
  --font-family-base: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --font-size-headline-lg: 48rpx;
  --line-height-headline-lg: 64rpx;
  --font-size-headline-md: 40rpx;
  --line-height-headline-md: 56rpx;
  --font-size-body-lg: 32rpx;
  --line-height-body-lg: 48rpx;
  --font-size-body-md: 28rpx;
  --line-height-body-md: 40rpx;
  --font-size-label-md: 24rpx;
  --line-height-label-md: 32rpx;
  --font-size-caption: 20rpx;
  --line-height-caption: 28rpx;
  --space-1: 8rpx;
  --space-2: 16rpx;
  --space-3: 24rpx;
  --space-4: 32rpx;
  --space-5: 40rpx;
  --space-6: 48rpx;
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;
  --radius-full: 9999rpx;
  --shadow-card: 0 4rpx 16rpx rgba(25, 28, 35, 0.08);
  --shadow-modal: 0 16rpx 48rpx rgba(25, 28, 35, 0.16);
  --height-button: 100rpx;
  --height-top-bar: 112rpx;
  --height-bottom-nav: 128rpx;
}

.text-headline-lg {
  color: var(--color-on-surface);
  font-size: var(--font-size-headline-lg);
  font-weight: 700;
  line-height: var(--line-height-headline-lg);
}

.text-headline-md {
  color: var(--color-on-surface);
  font-size: var(--font-size-headline-md);
  font-weight: 600;
  line-height: var(--line-height-headline-md);
}

.text-body-lg {
  color: var(--color-on-surface);
  font-size: var(--font-size-body-lg);
  font-weight: 400;
  line-height: var(--line-height-body-lg);
}

.text-body-md {
  color: var(--color-on-surface-variant);
  font-size: var(--font-size-body-md);
  font-weight: 400;
  line-height: var(--line-height-body-md);
}

.text-label-md {
  color: var(--color-on-surface-variant);
  font-size: var(--font-size-label-md);
  font-weight: 500;
  line-height: var(--line-height-label-md);
}

.text-caption {
  color: var(--color-on-surface-variant);
  font-size: var(--font-size-caption);
  line-height: var(--line-height-caption);
}

.surface-page {
  min-height: 100vh;
  background: var(--color-surface);
  color: var(--color-on-surface);
}

.surface-card {
  border: 2rpx solid rgba(193, 198, 214, 0.56);
  border-radius: var(--radius-lg);
  background: var(--color-surface-container-lowest);
  box-shadow: var(--shadow-card);
}

.status-chip {
  display: inline-flex;
  align-items: center;
  min-height: 40rpx;
  padding: 4rpx 18rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-size-label-md);
  font-weight: 600;
  line-height: var(--line-height-label-md);
}

.status-chip--info {
  background: #d8e2ff;
  color: #004493;
}

.status-chip--success {
  background: #dcfce3;
  color: var(--color-secondary);
}

.status-chip--warning {
  background: var(--color-tertiary-container);
  color: var(--color-tertiary);
}

.status-chip--error {
  background: var(--color-error-container);
  color: var(--color-on-error-container);
}

.token-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--height-button);
  padding: 0 var(--space-4);
  border-radius: var(--radius-md);
  font-size: var(--font-size-body-md);
  font-weight: 700;
  line-height: var(--line-height-body-md);
}

.token-button::after {
  border: 0;
}

.token-button--primary {
  background: var(--color-primary-container);
  color: var(--color-on-primary);
}

.token-button--secondary {
  border: 2rpx solid var(--color-outline-variant);
  background: var(--color-surface-container-lowest);
  color: var(--color-primary);
}

.token-input {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 0 var(--space-3);
  border: 2rpx solid var(--color-outline-variant);
  border-radius: var(--radius-md);
  background: var(--color-surface-container-lowest);
  color: var(--color-on-surface-variant);
  font-size: var(--font-size-body-md);
}

.time-slot {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 104rpx;
  padding: var(--space-2);
  border: 2rpx solid var(--color-outline-variant);
  border-radius: var(--radius-md);
  background: var(--color-surface-container-lowest);
}

.time-slot--available {
  border-color: rgba(0, 110, 44, 0.38);
  background: #ecfdf1;
}

.time-slot--selected {
  border-color: var(--color-secondary);
  background: var(--color-secondary-container);
}

.time-slot--unavailable {
  background: var(--color-surface-container-low);
  color: var(--color-on-surface-variant);
}

.time-slot--warning {
  border-color: rgba(158, 67, 0, 0.42);
  background: var(--color-tertiary-container);
}
