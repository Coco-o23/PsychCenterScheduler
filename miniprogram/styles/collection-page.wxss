.collection-page {
  min-height: 100vh;
  padding-bottom: calc(240rpx + env(safe-area-inset-bottom));
  background: var(--color-background);
}

.collection-page__content {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  padding: 0 var(--space-4) calc(240rpx + env(safe-area-inset-bottom));
}

.collection-page__hero {
  position: relative;
  overflow: hidden;
  padding: var(--space-5);
  color: var(--color-on-primary);
  background: linear-gradient(180deg, var(--color-primary-container) 0%, var(--color-primary) 100%);
}

.collection-page__hero--compact {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  min-height: 0;
}

.collection-page__hero::after {
  content: '';
  position: absolute;
  top: -44rpx;
  right: -12rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 9999rpx;
  background: rgba(255, 255, 255, 0.1);
}

.collection-page__hero-eyebrow,
.collection-page__hero-copy,
.collection-page__hero-meta {
  position: relative;
  z-index: 1;
}

.collection-page__hero-eyebrow {
  font-size: var(--font-size-label-md);
  line-height: var(--line-height-label-md);
  opacity: 0.92;
}

.collection-page__hero-title {
  position: relative;
  z-index: 1;
  margin-top: var(--space-1);
  font-size: var(--font-size-headline-lg);
  font-weight: 700;
  line-height: var(--line-height-headline-lg);
}

.collection-page__hero-copy {
  margin-top: var(--space-2);
  font-size: var(--font-size-body-md);
  line-height: var(--line-height-body-md);
  opacity: 0.96;
}

.collection-page__hero-copy--tight {
  margin-top: 0;
}

.collection-page__hero-meta {
  margin-top: var(--space-1);
  font-size: var(--font-size-label-md);
  line-height: var(--line-height-label-md);
  opacity: 0.92;
}

.collection-page__section-title {
  color: var(--color-on-surface);
  font-size: var(--font-size-body-lg);
  font-weight: 700;
  line-height: var(--line-height-body-lg);
}

.collection-page__summary-card,
.collection-page__submitted-card,
.collection-page__fill-card,
.collection-page__detail-card {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  padding: var(--space-4);
}

.collection-page__submitted-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
  width: 100%;
  padding: 0;
  background: transparent;
  text-align: left;
}

.collection-page__submitted-toggle::after {
  border: 0;
}

.collection-page__submitted-toggle-main {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 6rpx;
}

.collection-page__submitted-toggle-action {
  flex-shrink: 0;
  color: var(--color-primary);
  font-size: var(--font-size-label-md);
  font-weight: 700;
  line-height: var(--line-height-label-md);
}

.collection-page__entry-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
  width: 100%;
  padding: var(--space-4);
  text-align: left;
}

.collection-page__entry-card::after {
  border: 0;
}

.collection-page__entry-card-main {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  align-items: flex-start;
  gap: 6rpx;
}

.collection-page__entry-card-action {
  flex-shrink: 0;
  align-self: center;
  color: var(--color-primary);
  font-size: var(--font-size-body-md);
  font-weight: 700;
  line-height: var(--line-height-body-md);
}

.collection-page__published-card {
  border: 2rpx solid rgba(26, 102, 214, 0.12);
}

.collection-page__summary-header,
.collection-page__fill-header,
.collection-page__detail-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
}

.collection-page__summary-main {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
}

.collection-page__summary-title,
.collection-page__detail-title {
  color: var(--color-on-surface);
  font-size: var(--font-size-body-lg);
  font-weight: 700;
  line-height: var(--line-height-body-lg);
}

.collection-page__summary-subtitle,
.collection-page__detail-subtitle,
.collection-page__helper-text,
.collection-page__empty-copy {
  color: var(--color-on-surface-variant);
  font-size: var(--font-size-body-md);
  line-height: var(--line-height-body-md);
}

.collection-page__status-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-width: 112rpx;
  height: 64rpx;
  padding: 0 20rpx;
  border-radius: 9999rpx;
  text-align: center;
  font-size: var(--font-size-label-md);
  font-weight: 600;
  line-height: 1;
  box-sizing: border-box;
}


.collection-page__status-chip--pending {
  color: var(--color-on-surface-variant);
  background: var(--color-surface-container-high);
}

.collection-page__status-chip--active {
  color: var(--color-on-primary-container);
  background: rgba(26, 115, 232, 0.14);
}

.collection-page__status-chip--draft,
.collection-page__status-chip--adjusted {
  color: var(--color-primary);
  background: rgba(0, 91, 191, 0.1);
}

.collection-page__status-chip--completed {
  color: var(--color-on-secondary-container);
  background: rgba(134, 248, 152, 0.46);
}

.collection-page__progress-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
}

.collection-page__progress-bar {
  width: 100%;
  height: 20rpx;
  overflow: hidden;
  border-radius: 9999rpx;
  background: var(--color-surface-container-high);
}

.collection-page__progress-fill {
  height: 100%;
  border-radius: 9999rpx;
  background: var(--color-primary);
}

.collection-page__progress-fill--completed {
  background: var(--color-secondary);
}

.collection-page__progress-meta,
.collection-page__count-text {
  color: var(--color-primary);
  font-size: var(--font-size-label-md);
  font-weight: 700;
  line-height: var(--line-height-label-md);
}

.collection-page__count-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-3);
}

.collection-page__count-item {
  padding: var(--space-3);
  border-radius: var(--radius-card);
  background: var(--color-surface-container-low);
}

.collection-page__count-label {
  color: var(--color-on-surface-variant);
  font-size: var(--font-size-label-md);
  line-height: var(--line-height-label-md);
}

.collection-page__count-value {
  margin-top: var(--space-1);
  color: var(--color-on-surface);
  font-size: var(--font-size-headline-md);
  font-weight: 700;
  line-height: var(--line-height-headline-md);
}

.collection-page__button-row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
}

.collection-page__primary-button,
.collection-page__secondary-button,
.collection-page__ghost-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 36rpx;
  border-radius: 9999rpx;
  font-size: var(--font-size-body-md);
  font-weight: 600;
  line-height: 1;
  box-sizing: border-box;
}

.collection-page__primary-button {
  color: var(--color-on-primary);
  background: var(--color-primary);
}

.collection-page__secondary-button {
  color: var(--color-primary);
  background: var(--color-surface-container-low);
  border: 2rpx solid rgba(0, 91, 191, 0.16);
}

.collection-page__ghost-button {
  color: var(--color-on-surface-variant);
  background: transparent;
}

.collection-page__submitted-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.collection-page__submitted-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
}

.collection-page__collapse-toggle {
  min-width: 0;
  height: auto;
  min-height: 0;
  padding: 0;
  font-size: var(--font-size-label-md);
  line-height: var(--line-height-label-md);
}

.collection-page__collapse-toggle::after {
  border: 0;
}

.collection-page__submitted-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
  padding: var(--space-3);
  border-radius: var(--radius-card);
  background: var(--color-surface-container-low);
}

.collection-page__submitted-name {
  color: var(--color-on-surface);
  font-size: var(--font-size-body-md);
  font-weight: 600;
  line-height: var(--line-height-body-md);
}

.collection-page__submitted-meta {
  color: var(--color-on-surface-variant);
  font-size: var(--font-size-label-md);
  line-height: var(--line-height-label-md);
}

.collection-page__fill-options {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.collection-page__toggle-row,
.collection-page__select-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
}

.collection-page__toggle-row--divider,
.collection-page__select-row--divider {
  padding-top: var(--space-3);
  border-top: 2rpx solid rgba(210, 214, 225, 0.68);
}

.collection-page__toggle-main,
.collection-page__select-main {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
}

.collection-page__toggle-title,
.collection-page__select-title {
  color: var(--color-on-surface);
  font-size: var(--font-size-body-lg);
  font-weight: 700;
  line-height: var(--line-height-body-lg);
}

.collection-page__toggle-desc,
.collection-page__select-desc {
  color: var(--color-on-surface-variant);
  font-size: var(--font-size-label-md);
  line-height: var(--line-height-label-md);
}

.collection-page__switch {
  position: relative;
  width: 92rpx;
  height: 52rpx;
  border-radius: 9999rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(150, 158, 179, 0.52);
  background: #dfe3f1;
}

.collection-page__switch--active {
  border-color: rgba(0, 91, 191, 0.22);
  background: rgba(134, 248, 152, 0.86);
}

.collection-page__switch-thumb {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 9999rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 10rpx rgba(25, 28, 35, 0.12);
  transition: transform 0.2s ease;
}

.collection-page__switch--active .collection-page__switch-thumb {
  transform: translateX(40rpx);
}

.collection-page__max-options {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 16rpx;
}

.collection-page__picker-trigger {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 148rpx;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  border: 2rpx solid rgba(0, 91, 191, 0.18);
  background: var(--color-surface-container-low);
}

.collection-page__picker-value {
  color: var(--color-on-surface);
  font-size: var(--font-size-body-md);
  font-weight: 600;
  line-height: var(--line-height-body-md);
}

.collection-page__picker-arrow {
  color: var(--color-primary);
  font-size: 24rpx;
  line-height: 24rpx;
}

.collection-page__max-option {
  min-width: 88rpx;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 9999rpx;
  color: var(--color-on-surface);
  font-size: var(--font-size-body-md);
  line-height: 72rpx;
  text-align: center;
  background: var(--color-surface-container-low);
  border: 2rpx solid var(--color-outline-variant);
}

.collection-page__max-option--active {
  color: var(--color-on-secondary-container);
  background: var(--color-secondary-container);
  border-color: var(--color-primary);
}

.collection-page__day-card {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  padding: var(--space-4);
}

.collection-page__day-title {
  color: var(--color-primary);
  font-size: var(--font-size-body-lg);
  font-weight: 700;
  line-height: var(--line-height-body-lg);
}

.collection-page__slot-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-3);
}

.collection-page__slot-button {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  min-height: 160rpx;
  padding: var(--space-3);
  border-radius: var(--radius-card);
  background: var(--color-surface-container-lowest);
  border: 2rpx solid var(--color-outline-variant);
}

.collection-page__slot-button--active {
  color: var(--color-on-secondary-container);
  background: var(--color-secondary-container);
  border-color: var(--color-primary);
}

.collection-page__slot-button--disabled {
  opacity: 0.56;
}

.collection-page__slot-time {
  color: inherit;
  font-size: var(--font-size-label-md);
  line-height: var(--line-height-label-md);
}

.collection-page__slot-state {
  color: inherit;
  font-size: var(--font-size-body-lg);
  font-weight: 700;
  line-height: var(--line-height-body-lg);
}

.collection-page__empty-card {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  align-items: center;
  padding: 64rpx var(--space-4);
  text-align: center;
}

.collection-page__detail-day {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.collection-page__detail-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 12rpx;
}

.collection-page__detail-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
}

.collection-page__risk-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  height: 68rpx;
  min-height: 68rpx;
  padding: 0 22rpx;
  border-radius: 9999rpx;
  font-size: var(--font-size-label-md);
  font-weight: 600;
  line-height: 1;
  text-align: center;
  white-space: nowrap;
  box-sizing: border-box;
}

.collection-page__risk-chip--warning {
  color: var(--color-tertiary);
  background: rgba(197, 85, 0, 0.12);
}

.collection-page__risk-chip--critical {
  color: var(--color-error);
  background: rgba(186, 26, 26, 0.12);
}

.collection-page__member-list {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16rpx;
}

.collection-page__member-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  min-height: 64rpx;
  padding: 10rpx 12rpx 10rpx 20rpx;
  border-radius: 9999rpx;
  background: var(--color-surface-container-low);
  box-sizing: border-box;
}

.collection-page__member-chip--manual {
  background: rgba(134, 248, 152, 0.32);
}

.collection-page__member-text {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 44rpx;
  color: var(--color-on-surface);
  font-size: var(--font-size-label-md);
  line-height: 1.3;
  white-space: nowrap;
  text-align: center;
}

.collection-page__remove-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  align-self: center;
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  min-width: 44rpx;
  min-height: 44rpx;
  padding: 0;
  margin: 0;
  border-radius: 9999rpx;
  color: var(--color-error);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
  text-align: center;
  background: rgba(186, 26, 26, 0.1);
  box-sizing: border-box;
  vertical-align: middle;
}

.collection-page__remove-button::after {
  border: 0;
}

.collection-page__inline-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 132rpx;
  height: 68rpx;
  padding: 0 24rpx;
  line-height: 1;
  box-sizing: border-box;
}

.collection-page__floating-action {
  position: fixed;
  right: 32rpx;
  bottom: calc(var(--height-bottom-nav) + 132rpx);
  z-index: 30;
  width: 112rpx;
  height: 112rpx;
  border-radius: 9999rpx;
  color: var(--color-on-primary);
  font-size: var(--font-size-body-lg);
  font-weight: 700;
  background: var(--color-primary);
  box-shadow: var(--shadow-card);
}

.collection-page__bottom-action {
  position: fixed;
  right: 0;
  bottom: calc(112rpx + env(safe-area-inset-bottom));
  left: 0;
  z-index: 25;
  padding: 20rpx var(--space-4) 16rpx;
  background: linear-gradient(180deg, rgba(249, 249, 255, 0) 0%, rgba(249, 249, 255, 0.98) 28%);
}

.collection-page__bottom-submit {
  width: 100%;
}

.collection-page__modal-mask {
  position: fixed;
  inset: 0;
  z-index: 60;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: var(--space-4);
  background: rgba(25, 28, 35, 0.36);
}

.collection-page__modal {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  width: 100%;
  max-height: 72vh;
  padding: var(--space-4);
  border-radius: 28rpx;
  background: var(--color-surface-container-lowest);
}

.collection-page__modal-title {
  color: var(--color-on-surface);
  font-size: var(--font-size-headline-md);
  font-weight: 700;
  line-height: var(--line-height-headline-md);
}

.collection-page__modal-subtitle {
  color: var(--color-on-surface-variant);
  font-size: var(--font-size-body-md);
  line-height: var(--line-height-body-md);
}

.collection-page__modal-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  overflow-y: auto;
}

.collection-page__modal-footer {
  display: flex;
  justify-content: flex-end;
}

.collection-page__candidate-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
  padding: var(--space-3);
  border-radius: var(--radius-card);
  background: var(--color-surface-container-low);
}

.collection-page__candidate-main {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.collection-page__candidate-name {
  color: var(--color-on-surface);
  font-size: var(--font-size-body-md);
  font-weight: 600;
  line-height: var(--line-height-body-md);
}

.collection-page__candidate-meta {
  color: var(--color-on-surface-variant);
  font-size: var(--font-size-label-md);
  line-height: var(--line-height-label-md);
}

.collection-page__candidate-add {
  min-width: 112rpx;
}

.collection-page__empty-card--compact {
  padding: var(--space-4);
}
